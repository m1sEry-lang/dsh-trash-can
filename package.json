{
  "name": "dsh-trash-can",
  "version": "0.1.6",
  "description": "垃圾桶：把归档后的会话搬进可还原的回收站，360 小时后自动彻底删除",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "trash",
    "archive",
    "session"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/smoke.mjs && node test/flow.mjs && node test/delete-flow.mjs && node test/menu-dismiss.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}

